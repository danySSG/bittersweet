# Spotify OAuth (PKCE). Пусто = demo-режим (/api/demo/portrait работает без логина).
# Регистрация приложения: см. README.md.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/spotify/callback

# Google OAuth («Войти через YouTube», scope youtube.readonly).
# Пусто = все /auth/google/* отвечают 503. Настройка GCP: см. README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# URL фронтенда: точный origin для CORS (credentials!) и redirect после OAuth.
FRONTEND_URL=http://localhost:3000

# Secure-флаг session-cookie: 0 на локалке (http://localhost), 1 на проде
# за HTTPS-прокси. samesite остаётся lax в обоих случаях.
COOKIE_SECURE=0

# Секрет для подписи session-cookie (замените на случайную строку).
# Из него же выводится ключ шифрования refresh_token'ов Google (HKDF):
# смена секрета разлогинит пользователей — они просто войдут заново.
SESSION_SECRET=change-me-to-a-random-string

# Путь к SQLite-кэшу (дескрипторы, аккаунты, портреты, джобы).
# По умолчанию — service/backend/cache.db; в Docker/на проде задайте путь
# на примонтированный volume, например CACHE_DB=/data/cache.db.
# CACHE_DB=/data/cache.db

# CSV признаков для demo-портрета.
# По умолчанию (если не задано) — абсолютный путь до <repo>/data/features_full.csv,
# вычисленный от расположения app/config.py (эквивалент ../../data/features_full.csv).
# DEMO_FEATURES_CSV=/absolute/path/to/data/features_full.csv
